<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newsradar.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/YOUR PATH/news_radar_ai_agent/.venv/bin/python</string>
        <string>-m</string>
        <string>tools.daily_job</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/YOUR PATH/news_radar_ai_agent</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/news_radar_ai_agent.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/news_radar_ai_agent_error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
